<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de la fenêtre pendant le démarrage du processus (mode clair). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Thème appliqué dès le processus démarré, pendant l'initialisation de
         l'interface Flutter. Même vert que le splash : `?android:colorBackground`
         valait blanc et réintroduisait le flash juste après le splash natif. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
